# Copy to .env in the repository root. The PowerShell scripts load it; never commit .env.
# Database (native PostgreSQL on this machine)
DB_URL=jdbc:postgresql://localhost:5432/spatial
DB_USER=spatial
DB_PASSWORD=

# At least 32 characters. Generate: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }) -as [byte[]])
JWT_SECRET=

# Where the Java backend and the Python service share uploaded media. Leave empty to use <repo>\data\storage.
STORAGE_ROOT=

BACKEND_PORT=8080
AI_PORT=8000
FRONTEND_PORT=3000
# Origins the browser may call the API from (the localhost/127.0.0.1 twin of each is added automatically)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
AI_SERVICE_URL=http://localhost:8000

# AI service tuning (all optional)
YOLO_MODEL=yolov8m-seg.pt
DEPTH_ENABLED=1
DEPTH_MODEL=depth-anything/Depth-Anything-V2-Metric-Indoor-Small-hf
# COLMAP: leave EMPTY to use the bundled CPU build in tools\colmap\bin (recommended; its folder is put on PATH automatically
# so Windows finds its DLLs). Set a full path to colmap.exe only to override the bundle with another build.
COLMAP_BIN=
# Check the COLMAP database after feature extraction and matching (1 = on)
COLMAP_VALIDATE_DB=1
# Optional vocabulary tree file (not bundled) to enable loop-closure matching for sequential video matching
COLMAP_VOCAB_TREE=
COLMAP_USE_GPU=0
MAX_VIDEO_SECONDS=900

# --- Intel CPU / Iris Xe reconstruction (all optional; defaults suit a 4-core i5 with 16 GB RAM) -----------------------
# Jobs run one at a time so memory stays predictable. Raise only on a bigger machine.
JOB_CONCURRENCY=1
# 0 = logical cores minus one
CPU_THREADS=0
# auto: use Intel XPU only after a smoke test passes; 0: CPU only
XPU_MODE=0
# RAM kept free for Windows and the browser; heavy stages refuse to start below this
MEMORY_RESERVE_MB=2500
# minimum usable frames after blur/duplicate removal
MIN_FRAMES=8
# frames sampled per second of video (only used when FRAME_SAMPLING=fixed; lower = fewer, faster)
FRAME_TARGET_FPS=3
# adaptive (default): keep frames by measured camera motion, drop blur/duplicates, keep room transitions; fixed: every Nth frame
FRAME_SAMPLING=adaptive
# image motion (fraction of frame width) between kept frames; lower = more frames and more overlap
FRAME_MOTION_TARGET=0.05
# a video whose total measured camera motion is below this is rejected as static
FRAME_STATIC_MIN_MOTION=0.25
# auto: COLMAP if found, else built-in OpenCV (flat video only); colmap; opencv
SFM_BACKEND=auto
SFM_MAX_IMAGES=90
SFM_MAX_SIDE=960
# optional output of scripts\calibrate_camera.py
CAMERA_INTRINSICS_FILE=
# mesh resolution along the longest axis
DENSE_VOXELS=160
# frames used for depth fusion
DENSE_MAX_FRAMES=40
SPLAT_ENABLED=1
SPLAT_MAX_GAUSSIANS=4000
# training image size in pixels
SPLAT_MAX_SIDE=128
SPLAT_ITERATIONS=300
# training stops here even if iterations remain (the report says how many ran)
SPLAT_TIME_BUDGET_SEC=900

# --- Development access (LOCAL TESTING ONLY, OFF by default) ----------------------------------------------------
# Leave this false for normal use: register and sign in on /register and /login. Setting it to true skips the login screen
# and makes the backend act as an EXISTING user for requests from this machine (see docs/DEV_ACCESS.md).
# Production builds and prod/production/staging profiles never allow it. Restart backend and frontend after changing it.
DEV_ACCESS=false
DEV_ACCESS_EMAIL=

# --- Adaptive memory (reconstruction picks a plan from the RAM that is free when the job starts) -------------------------
# auto, normal, low or minimal. Force minimal on a machine that keeps running out of memory.
LOW_MEMORY_MODE=auto
# Free RAM at or above this runs the configured quality.
MEMORY_NORMAL_MB=5500
# Free RAM at or above this runs the low-memory plan; below it the minimal plan runs.
MEMORY_LOW_MB=2800
# Below this the job is refused with advice instead of risking a freeze.
MIN_FREE_RAM_MB=1200

# --- Verified viewpoint links (all optional) --------------------------------------------------------------------------
# Two viewpoints are linked only when the reconstruction proves they see the same features. Never by video order or distance alone.
# Common 3D landmarks two viewpoints must share (pose-based tour). Lowered automatically for sparse models, never below 8.
TOUR_MIN_SHARED_LANDMARKS=20
# Shared landmarks divided by the smaller landmark set of the two viewpoints.
TOUR_MIN_OVERLAP=0.12
# Median angle (degrees) under which a shared landmark is seen from the two camera positions. Rejects pure rotation.
TOUR_MIN_PARALLAX_DEG=0.3
# Maximum angle (degrees) between the two viewing directions.
TOUR_MAX_VIEW_ANGLE_DEG=100
# A link between moments at least this many seconds apart is a loop closure and needs 1.5x the shared landmarks.
TOUR_LOOP_MIN_GAP_SEC=8
# Viewpoints aimed for by the no-COLMAP tour when the footage is long enough (never more than TOUR_MAX_VIEWPOINTS).
TOUR_TARGET_VIEWPOINTS=20
# 0 (default): a link that cannot be verified is not created. 1: restore the old behaviour (video-order links across cuts, flagged unverified).
TOUR_ALLOW_UNVERIFIED_LINKS=0
